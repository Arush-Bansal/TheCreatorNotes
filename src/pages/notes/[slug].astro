---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import notesData from "../../data/notes.json";

export async function getStaticPaths() {
  return notesData.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
---

<Layout title={note.title}>
  <Navbar />

  <main class="note-page">
    <div class="container narrow">
      <header class="note-header">
        <div class="header-meta">
          <span class="category-tag box-border">{note.category}</span>
          <span class="date hand-drawn">{note.date}</span>
        </div>
        <h1>{note.title}</h1>
        <div class="author-line">
          <img
            src="https://api.dicebear.com/7.x/bottts/svg?seed=creator"
            alt="Avatar"
            class="avatar box-border"
          />
          <span>By <strong>The Creator Team</strong></span>
        </div>
      </header>

      <div class="note-content">
        <p class="lead highlight-teal">
          {note.lead}
        </p>

        <section class="editorial-section">
          <h2>The Core Problem</h2>
          <p>{note.problem}</p>

          <div class="annotation-container">
            <div class="main-text">
              <p>
                Strategy is about making choices, tradeoffs; it's about
                deliberately choosing to be different.
              </p>
            </div>
            <div class="annotation hand-drawn">
              This is the "North Star" of growth!
            </div>
          </div>
        </section>

        <section class="insight-box box-border shadow-offset">
          <div class="insight-header">
            <span class="insight-icon">💡</span>
            <h3 class="hand-drawn">Strategic Insight</h3>
          </div>
          <p>{note.insight}</p>
        </section>

        <section class="editorial-section">
          <h2>How to Implement</h2>
          <p>Follow these three fundamental shifts in your daily workflow:</p>
          <ul class="illustrated-list">
            {
              note.steps.map((step, index) => (
                <li>
                  <span class="list-number">0{index + 1}</span>
                  <div>
                    <strong>{step.title}:</strong> {step.desc}
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="quote-block box-border">
          <span class="quote-mark">“</span>
          <blockquote>{note.quote}</blockquote>
        </div>
      </div>

      <div class="note-footer">
        <div class="next-step box-border shadow-offset">
          <div class="hand-drawn label">Suggested Next Read</div>
          <h3>{note.nextTitle}</h3>
          <a href={`/notes/${note.nextSlug}`} class="btn btn-primary"
            >Take the next step</a
          >
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .note-page {
    padding-top: 6rem;
    padding-bottom: 8rem;
    background: white;
  }

  .narrow {
    max-width: 750px;
  }

  .note-header {
    margin-bottom: 4rem;
  }

  .header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .category-tag {
    background: var(--accent-yellow);
    padding: 0.2rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .date {
    font-size: 0.9rem;
    color: var(--accent-red);
  }

  .note-header h1 {
    font-size: 3.5rem;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .author-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-primary);
  }

  .note-content {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .lead {
    padding: 1.5rem;
    border-left: 5px solid var(--accent-teal);
    margin-bottom: 3rem;
    font-weight: 500;
  }

  h2 {
    font-size: 2.25rem;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
  }

  p {
    margin-bottom: 1.5rem;
  }

  .annotation-container {
    position: relative;
    margin: 3rem 0;
  }

  .annotation {
    position: absolute;
    right: -100px;
    top: 50%;
    width: 150px;
    color: var(--accent-red);
    font-size: 0.9rem;
    transform: rotate(5deg);
    line-height: 1.2;
  }

  .annotation::before {
    content: "→";
    display: block;
    margin-bottom: 5px;
    font-size: 1.5rem;
  }

  .insight-box {
    padding: 2.5rem;
    background: var(--bg-primary);
    margin: 4rem 0;
  }

  .insight-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .insight-header h3 {
    font-size: 1.1rem;
    color: var(--accent-teal);
  }

  .illustrated-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 3rem 0;
  }

  .illustrated-list li {
    display: flex;
    gap: 1.5rem;
  }

  .list-number {
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--accent-red);
    opacity: 0.3;
  }

  .quote-block {
    padding: 3rem;
    margin: 4rem 0;
    position: relative;
    text-align: center;
  }

  .quote-mark {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 4rem;
    background: white;
    line-height: 1;
    padding: 0 1rem;
    color: var(--accent-red);
  }

  blockquote {
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .note-footer {
    margin-top: 6rem;
  }

  .next-step {
    padding: 3rem;
    text-align: center;
    background: var(--accent-yellow);
  }

  .next-step .label {
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .next-step h3 {
    font-size: 1.8rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 1000px) {
    .annotation {
      position: static;
      margin-top: 1rem;
      width: 100%;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .note-header h1 {
      font-size: 2.5rem;
    }
    blockquote {
      font-size: 1.4rem;
    }
  }
</style>
