---
interface Props {
    size?: number;
    className?: string;
    color?: string;
    accentColor?: string;
}

const {
    size = 32,
    className = "",
    color = "var(--text-primary)",
    accentColor = "var(--accent-red)",
} = Astro.props;
---

<div
    class={`logo-wrapper ${className}`}
    style={`width: ${size}px; height: ${size}px;`}
>
    <svg
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="logo-icon"
        style={`color: ${color};`}
    >
        <!-- Main C-shape/Note container -->
        <path
            d="M25 7V5C25 4.44772 24.5523 4 24 4H8C5.79086 4 4 5.79086 4 8V24C4 26.2091 5.79086 28 8 28H24C24.5523 28 25 27.5523 25 27V25"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>

        <!-- Decorative Note Lines -->
        <path
            d="M11 12H18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        <path
            d="M11 16H18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        <path
            d="M11 20H15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>

        <!-- Folded Corner Accent -->
        <path
            d="M25 10L20 10C19.4477 10 19 9.55228 19 9V4L25 10Z"
            fill={accentColor}
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
    </svg>
</div>

<style>
    .logo-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .logo-icon {
        width: 100%;
        height: 100%;
        color: var(--text-primary);
    }

    .logo-wrapper:hover {
        transform: rotate(-5deg) scale(1.1);
    }
</style>
